{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Customer wallet and account summary.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "Display name" },
        "email": { "type": "string", "description": "Verified Google account email visible to Admin" },
        "balanceKs": { "type": "integer", "description": "Available balance in Ks" },
        "rewardPoints": { "type": "integer", "description": "Reward points" },
        "activeStakeKs": { "type": "integer", "description": "Active pending/accepted order stake in Ks" },
        "totalWonKs": { "type": "integer", "description": "Lifetime settled winnings in Ks" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "displayName", "balanceKs", "rewardPoints", "activeStakeKs", "totalWonKs", "createdAt", "updatedAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public non-PII standings entry for customer leaderboard.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "rewardPoints": { "type": "integer" },
        "totalWonKs": { "type": "integer" },
        "visibility": { "type": "string", "enum": ["public"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "rewardPoints", "totalWonKs", "visibility", "updatedAt"]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Authorized admin or co-admin friend account.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin"] },
        "addedBy": { "type": "string" },
        "inviteCodeUsed": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "role", "addedBy", "inviteCodeUsed", "createdAt", "updatedAt"]
    },
    "AdminInvite": {
      "title": "AdminInvite",
      "description": "Shareable invite code allowing friends to join as co-admins.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "label": { "type": "string" },
        "active": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "label", "active", "createdBy", "createdAt", "updatedAt"]
    },
    "SportMatch": {
      "title": "SportMatch",
      "description": "Football match board for Parlay and Body/Goal Total picks.",
      "type": "object",
      "properties": {
        "league": { "type": "string" },
        "homeTeam": { "type": "string" },
        "awayTeam": { "type": "string" },
        "kickoffLabel": { "type": "string" },
        "handicapLine": { "type": "string" },
        "goalLine": { "type": "string" },
        "bodyOdds": { "type": "number" },
        "goalOdds": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed", "finished"] },
        "homeScore": { "type": "integer" },
        "awayScore": { "type": "integer" },
        "visibility": { "type": "string", "enum": ["public", "hidden"] },
        "externalId": { "type": "string" },
        "matchDate": { "type": "string" },
        "liveClock": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["league", "homeTeam", "awayTeam", "kickoffLabel", "handicapLine", "goalLine", "bodyOdds", "goalOdds", "status", "homeScore", "awayScore", "visibility", "createdBy", "createdAt", "updatedAt"]
    },
    "LotteryDraw": {
      "title": "LotteryDraw",
      "description": "3D lucky number draw round and published result.",
      "type": "object",
      "properties": {
        "roundTitle": { "type": "string" },
        "closeTimeLabel": { "type": "string" },
        "winningNumber": { "type": "string" },
        "payoutMultiplier": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed", "finished"] },
        "visibility": { "type": "string", "enum": ["public", "hidden"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roundTitle", "closeTimeLabel", "winningNumber", "payoutMultiplier", "status", "visibility", "createdBy", "createdAt", "updatedAt"]
    },
    "BetOrder": {
      "title": "BetOrder",
      "description": "Customer order slip for Parlay, Body/Goal, or 3D.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "orderType": { "type": "string", "enum": ["parlay", "body_goal", "three_d"] },
        "selections": { "type": "array" },
        "matchIds": { "type": "array" },
        "pickKeys": { "type": "array" },
        "drawRound": { "type": "string" },
        "stakeKs": { "type": "integer" },
        "multiplier": { "type": "number" },
        "potentialPayoutKs": { "type": "integer" },
        "actualPayoutKs": { "type": "integer" },
        "commissionPercent": { "type": "number" },
        "commissionKs": { "type": "integer" },
        "status": { "type": "string", "enum": ["pending", "accepted", "won", "lost", "rejected"] },
        "adminNote": { "type": "string" },
        "settledBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "customerName", "orderType", "selections", "matchIds", "drawRound", "stakeKs", "multiplier", "potentialPayoutKs", "actualPayoutKs", "status", "adminNote", "settledBy", "createdAt", "updatedAt"]
    },
    "WalletRequest": {
      "title": "WalletRequest",
      "description": "Customer top-up or cash-out request managed by Admin.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "requestType": { "type": "string", "enum": ["topup", "withdraw"] },
        "amountKs": { "type": "integer" },
        "channel": { "type": "string" },
        "referenceNote": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminNote": { "type": "string" },
        "processedBy": { "type": "string" },
        "ratePercent": { "type": "number" },
        "rateMode": { "type": "string", "enum": ["none", "bonus", "fee"] },
        "netAmountKs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "customerName", "requestType", "amountKs", "channel", "referenceNote", "status", "adminNote", "processedBy", "createdAt", "updatedAt"]
    },
    "LedgerTransaction": {
      "title": "LedgerTransaction",
      "description": "Immutable financial ledger record for customer wallet.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "txType": { "type": "string", "enum": ["topup", "withdraw", "order_stake", "order_win", "order_refund", "point_exchange", "admin_adjust", "point_gift"] },
        "direction": { "type": "string", "enum": ["credit", "debit"] },
        "amountKs": { "type": "integer" },
        "title": { "type": "string" },
        "balanceAfterKs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "txType", "direction", "amountKs", "title", "balanceAfterKs", "createdAt", "updatedAt"]
    },
    "WalletConfig": {
      "title": "WalletConfig",
      "description": "Admin-configurable deposit and withdrawal percentage rules.",
      "type": "object",
      "properties": {
        "depositPercent": { "type": "number" },
        "depositMode": { "type": "string", "enum": ["none", "bonus", "fee"] },
        "withdrawPercent": { "type": "number" },
        "withdrawMode": { "type": "string", "enum": ["none", "bonus", "fee"] },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["depositPercent", "depositMode", "withdrawPercent", "withdrawMode", "updatedBy", "updatedAt"]
    },
    "BoardConfig": {
      "title": "BoardConfig",
      "description": "Admin-configurable automatic daily fixtures and live result sync flags.",
      "type": "object",
      "properties": {
        "autoSyncDailyMatches": { "type": "boolean" },
        "autoSyncLiveResults": { "type": "boolean" },
        "lastSyncedDate": { "type": "string" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["autoSyncDailyMatches", "autoSyncLiveResults", "lastSyncedDate", "updatedBy", "updatedAt"]
    },
    "BettingConfig": {
      "title": "BettingConfig",
      "description": "Admin-configurable winning commission percentage and auto-settlement flags.",
      "type": "object",
      "properties": {
        "winCommissionPercent": { "type": "number" },
        "winCommissionBasis": { "type": "string", "enum": ["payout", "profit"] },
        "autoSettleOrders": { "type": "boolean" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["winCommissionPercent", "winCommissionBasis", "autoSettleOrders", "updatedBy", "updatedAt"]
    },
    "AppUpdateConfig": {
      "title": "AppUpdateConfig",
      "description": "Admin-published APK release metadata for customer auto-update prompts.",
      "type": "object",
      "properties": {
        "latestVersionCode": { "type": "integer" },
        "latestVersionName": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "releaseNotes": { "type": "string" },
        "forceUpdate": { "type": "boolean" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["latestVersionCode", "latestVersionName", "downloadUrl", "releaseNotes", "forceUpdate", "updatedBy", "updatedAt"]
    },
    "DirectChatMessage": {
      "title": "DirectChatMessage",
      "description": "Private 1-on-1 chat message between a Customer and Admin.",
      "type": "object",
      "properties": {
        "threadUserId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["customer", "admin"] },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["threadUserId", "senderId", "senderName", "senderRole", "text", "createdAt"]
    },
    "GroupChatMessage": {
      "title": "GroupChatMessage",
      "description": "Shared community group chat message for Customers and Admins.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["customer", "admin"] },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "senderRole", "text", "createdAt"]
    },
    "AppQualityReview": {
      "title": "AppQualityReview",
      "description": "User quality rating and tier feedback.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "stars": { "type": "integer" },
        "qualityTier": { "type": "string" },
        "comment": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "stars", "qualityTier", "comment", "updatedAt"]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "WebRTC signaling session for 1-on-1 Voice and Video calls between Customer and Admin.",
      "type": "object",
      "properties": {
        "threadUserId": { "type": "string" },
        "callerId": { "type": "string" },
        "callerName": { "type": "string" },
        "callerRole": { "type": "string", "enum": ["customer", "admin"] },
        "calleeName": { "type": "string" },
        "callType": { "type": "string", "enum": ["voice", "video"] },
        "status": { "type": "string", "enum": ["ringing", "accepted", "rejected", "ended"] },
        "offerSdp": { "type": "string" },
        "answerSdp": { "type": "string" },
        "answeredBy": { "type": "string" },
        "answeredByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["threadUserId", "callerId", "callerName", "callerRole", "calleeName", "callType", "status", "offerSdp", "answerSdp", "answeredBy", "answeredByName", "createdAt", "updatedAt"]
    },
    "CallIceCandidate": {
      "title": "CallIceCandidate",
      "description": "WebRTC ICE candidate exchanged within a call session.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "sdpMid": { "type": "string" },
        "sdpMLineIndex": { "type": "integer" },
        "candidate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "sdpMid", "sdpMLineIndex", "candidate", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user account balances, points, and email."
    },
    "/leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Public standings board without PII."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Authorized admin and co-admin members."
    },
    "/admin_invites/{inviteCode}": {
      "schema": { "$ref": "#/entities/AdminInvite" },
      "description": "Shareable admin invite codes."
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/SportMatch" },
      "description": "Football matches for Parlay and Body/Goal orders."
    },
    "/lottery_draws/{drawId}": {
      "schema": { "$ref": "#/entities/LotteryDraw" },
      "description": "3D lottery draw rounds and results."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/BetOrder" },
      "description": "Customer order slips monitored by Admins."
    },
    "/wallet_requests/{requestId}": {
      "schema": { "$ref": "#/entities/WalletRequest" },
      "description": "Customer top-up and cash-out requests."
    },
    "/transactions/{txId}": {
      "schema": { "$ref": "#/entities/LedgerTransaction" },
      "description": "Customer balance ledger history."
    },
    "/app_settings/wallet_config": {
      "schema": { "$ref": "#/entities/WalletConfig" },
      "description": "Deposit and withdrawal percentage configuration."
    },
    "/app_settings/board_config": {
      "schema": { "$ref": "#/entities/BoardConfig" },
      "description": "Daily match and live result sync configuration."
    },
    "/app_settings/betting_config": {
      "schema": { "$ref": "#/entities/BettingConfig" },
      "description": "Winning commission and auto-settlement configuration."
    },
    "/app_settings/app_update": {
      "schema": { "$ref": "#/entities/AppUpdateConfig" },
      "description": "APK release notification settings."
    },
    "/direct_messages/{msgId}": {
      "schema": { "$ref": "#/entities/DirectChatMessage" },
      "description": "1-on-1 direct chat messages scoped by customer threadUserId."
    },
    "/group_messages/{msgId}": {
      "schema": { "$ref": "#/entities/GroupChatMessage" },
      "description": "Community group chat messages for Customers and Admins."
    },
    "/app_reviews/{userId}": {
      "schema": { "$ref": "#/entities/AppQualityReview" },
      "description": "User quality ratings and feedback."
    },
    "/call_sessions/{callId}": {
      "schema": { "$ref": "#/entities/CallSession" },
      "description": "Voice & Video WebRTC call signaling sessions scoped by customer threadUserId."
    },
    "/call_sessions/{callId}/candidates/{candId}": {
      "schema": { "$ref": "#/entities/CallIceCandidate" },
      "description": "WebRTC ICE candidates for a call session."
    }
  }
}
